{
  "manifest_version": 3,
  "name": "Promper",
  "version": "1.0",
  "description": "This extension is used to build proper prompt according to user's query .",
  "action": {
    "default_popup": "index.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "48": "icon.png"
  },
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "scripting",
    "webRequest"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "ai_response/chatgpt.js"
      ]
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "ai_response/gemini.js"
      ]
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "ai_response/claude.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "llm-api/response.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}